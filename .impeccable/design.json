  "narrative": {
    "northStar": "The Review Desk",
    "overview": "Codeignite looks like a quiet desk where work arrives with its evidence and a person signs it off. The surface is near-black and flat. Type is the system font at small sizes, with monospace for everything that is a record: repository names, branches, counts, step trails. One warm colour, Lamp Sand, marks what waits for the person at the desk.\n\nThe components feel like calm paperwork. Panels read top to bottom, each control has a caption that says what it does, and the reader decides only after reading. Nothing is decorative, and nothing moves except a border on hover.\n\nThe interface is compact and dark by commitment. No light theme exists.",
    "keyCharacteristics": [
      "Near-black, flat surfaces separated by hairlines.",
      "One warm accent on a field of neutral greys.",
      "System sans for prose, monospace for records.",
      "Dense: most interface text is 12px to 14px.",
      "Status is always written in words, with colour as a second signal."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "Lamp Sand is the only accent hue. Sage means passed or live and Clay means failed; no other hue is used.",
        "section": "colors"
      },
      {
        "name": "The Words First Rule",
        "body": "A status is written out (\"Your turn · answer the agent\", \"(done)\"). Colour repeats the word and never replaces it.",
        "section": "colors"
      },
      {
        "name": "The Mono Is A Record Rule",
        "body": "Monospace is for things the system recorded: names, paths, counts, steps, logs. Sentences are never set in mono.",
        "section": "typography"
      },
      {
        "name": "The Flat Desk Rule",
        "body": "Nothing at rest has a shadow. A shadow means the element floats above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do write a status in words and let colour repeat it.",
      "Do keep controls in one row at 40px, and buttons at 34px.",
      "Do put a label above each field and a caption below a control whose effect is not obvious.",
      "Do use Well for anything typed, logged or diffed, and Card for anything read.",
      "Do use monospace for recorded facts and the system sans for sentences.",
      "Do keep one primary button per panel or dialog.",
      "Do name the action on a confirm button (\"Approve commit 1a2b3c4d5e6f\", \"Archive task\")."
    ],
    "donts": [
      "Don't add a second accent hue. Lamp Sand, Sage and Clay are the whole set.",
      "Don't add a shadow to anything that does not float.",
      "Don't add a light theme.",
      "Don't load a web font.",
      "Don't set sentences in monospace.",
      "Don't colour a link, a label or a notice with Lamp Sand.",
      "Don't offer Approve where the changes, the evidence and the description are not on screen."
    ]
  }
}
